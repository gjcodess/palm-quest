{
  "name": "palmquest",
  "version": "1.0.0",
  "description": "Coconut Palm Crackers: Virtual Laboratory Challenge",
  "author": "PALMQuest",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons:generate": "node scripts/generate_app_icons.mjs",
    "android:sync": "npm run icons:generate && npm run build && cap sync android",
    "android:open": "cap open android",
    "desktop:run": "npm run build && electron .",
    "desktop:make": "npm run build && electron-forge make --platform win32",
    "preview": "vite preview",
    "docs:docx": "node scripts/generate_docx.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.7.1",
    "electron": "^44.5.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
